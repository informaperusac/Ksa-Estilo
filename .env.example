# ─────────────────────────────────────────────────────────────
# Ksa Estilo — configuración del sitio
# Copia este archivo como `.env` (o `.env.local`) y completa los valores.
# Todos son opcionales: lo que no se configure simplemente no se muestra.
# Reinicia `npm run dev` después de modificarlo.
# ─────────────────────────────────────────────────────────────

# Dominio público, sin barra final. Se usa para canonical, Open Graph y sitemap.xml.
# Ejemplo: https://www.tudominio.pe
VITE_SITE_URL=

# WhatsApp en formato internacional, solo dígitos (código de país + número).
# Perú: 51 + 9 dígitos del celular. Ejemplo de formato: 51XXXXXXXXX
VITE_WHATSAPP_NUMBER=

# Datos de contacto visibles en el sitio
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_ADDRESS=
# Separa cada línea de horario con "|". Ejemplo: Lunes a viernes: 9:00 a 18:00|Sábados: 9:00 a 13:00
VITE_BUSINESS_HOURS=
# URL de inserción de Google Maps (Compartir → Insertar un mapa → copia solo el valor de src).
# El mapa solo se muestra si hay dirección y esta URL.
VITE_MAP_EMBED_URL=

# Redes sociales (URL completas)
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=
VITE_PINTEREST_URL=

# Crédito del desarrollador en el pie de página
VITE_ALUQIS_URL=

# Muestra los avisos de "contenido demostrativo". Cambia a false al publicar contenido real.
VITE_DEMO_MODE=true

# Futuro: URL base de la API REST (ERP). Si está vacía, el catálogo usa los datos locales.
VITE_API_URL=
